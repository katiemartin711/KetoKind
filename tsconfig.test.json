{
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "dist-test",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/db/**/*.ts",
    "src/types.ts",
    "src/theme.ts",
    "src/datetime.ts",
    "src/confirmDelete.ts",
    "src/milestones.ts",
    "src/dietPrinciples.ts",
    "src/nodeSqliteAdapter.ts",
    "src/profileValidation.ts",
    "src/numberParsing.ts",
    "src/pro.ts",
    "src/trendsStats.ts",
    "src/foodGroups.ts",
    "src/reminderLogic.ts",
    "src/components/log/medSuppSelection.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
